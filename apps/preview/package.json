{
  "name": "@agat/platform-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint src",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@agat/i18n": "workspace:*",
    "@agat/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  }
}
