generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  COURIER
  ADMIN
  FINANCE_ADMIN
}

enum PartnerStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

enum NetworkVersionStatus {
  ACTIVE
  RETIRED
}

enum PlatformCatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum OrderDraftStatus {
  CONFIGURING
  FILE_UPLOADED
  PROCESSING
  AWAITING_APPROVAL
  READY_FOR_QUOTE
  QUOTED
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum PriceQuoteStatus {
  ACTIVE
  CONSUMED
  STALE
  EXPIRED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  DEAD_LETTER
}

enum AvailabilityKind {
  AVAILABLE
  UNAVAILABLE
}

enum CapacityReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

enum MatchingReasonCode {
  ELIGIBLE
  CUSTOMER_PREFERRED
  PARTNER_NOT_ACTIVE
  BRANCH_INACTIVE
  ORDERS_DISABLED
  CAPABILITY_MISMATCH
  SERVICE_DISABLED
  OUTSIDE_WORKING_HOURS
  TEMPORARILY_UNAVAILABLE
  OUTSIDE_SERVICE_AREA
  CAPACITY_FULL
  STALE_NETWORK_VERSION
}

enum StudioListingStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
  RETIRED
}

enum StudioPreferenceMode {
  AUTO_ASSIGN
  PREFERRED_STUDIO
}

enum StudioFallbackPolicy {
  ALLOW_ELIGIBLE_ALTERNATIVE
  STRICT_PREFERENCE
}

enum ObjectRetentionClass {
  ORIGINAL
  PREVIEW
  DERIVATIVE
  PRINT_READY
}

enum UploadFileKind {
  PDF
  DOCX
  JPEG
  PNG
}

enum UploadStatus {
  CREATED
  QUARANTINED
  SCANNING
  QUEUED
  PROCESSING
  READY
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

enum ProcessingOperation {
  NORMALIZE
  PREFLIGHT
}

enum LayoutStatus {
  PROCESSING
  QUALITY_CHECK_FAILED
  MANUAL_REVIEW_REQUIRED
  AWAITING_APPROVAL
  APPROVED
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum TariffStatus {
  ACTIVE
  RETIRED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  MATCHING
  PARTNER_OFFERED
  PARTNER_ACCEPTED
  IN_PRODUCTION
  READY
  AWAITING_PICKUP
  COURIER_ASSIGNED
  IN_DELIVERY
  DELIVERY_FAILED
  COMPLETED
  DISPUTED
  REPRINT
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum DisputeCategory {
  PRINT_QUALITY
  WRONG_OUTPUT
  DAMAGED
  MISSING_ITEMS
  DELIVERY_FAILURE
}

enum DisputeStatus {
  OPEN
  PARTNER_RESPONDED
  RESOLVED
  CANCELLED
}

enum DisputeResolutionType {
  NO_ACTION
  REPRINT
  PARTIAL_REFUND
  FULL_REFUND
}

enum ProductionCycleKind {
  ORIGINAL
  REPRINT
}

enum ProductionCycleStatus {
  CREATED
  IN_PRODUCTION
  READY
  FULFILLING
  COMPLETED
  FAILED
}

enum CourierStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum FulfillmentMode {
  PICKUP
  DELIVERY
}

enum FulfillmentStatus {
  AWAITING_HANDOFF
  IN_DELIVERY
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  ASSIGNED
  IN_DELIVERY
  DELIVERED
  FAILED
}

enum PrinterAgentStatus {
  ACTIVE
  REVOKED
}

enum PrintJobStatus {
  PENDING
  LEASED
  PRINTING
  COMPLETED
  FAILED
  CANCELLED
}

enum CapabilityStatus {
  ACTIVE
  RETIRED
}

enum MatchingStatus {
  ACTIVE
  ASSIGNED
  EXHAUSTED
}

enum PartnerOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AssignmentStatus {
  ACTIVE
  READY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundKind {
  FULL
  PARTIAL
}

enum RefundStatus {
  REQUESTED
  CONFIRMED
}

enum RetentionScheduleStatus {
  ACTIVE
  HELD
  SUPERSEDED
  COMPLETED
}

enum TombstoneApplyStatus {
  PENDING
  APPLIED
}

enum AftercareJobStatus {
  PENDING
  RUNNING
  DONE
  DEAD_LETTER
}

enum FinancialJobStatus {
  PENDING
  RUNNING
  DONE
  DEAD_LETTER
}

enum FiscalOperationType {
  SALE
  REFUND
}

enum FiscalOperationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  RETRY_PENDING
  RECONCILIATION_REQUIRED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryType {
  EARNING
  REFUND_ADJUSTMENT
}

enum SettlementBatchStatus {
  CREATED
  SUBMITTED
  SETTLED
  RETRY_PENDING
  RECONCILIATION_REQUIRED
}

enum ReconciliationKind {
  PAYMENT
  FISCAL
  PAYOUT
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  RESOLVED
}

model AftercareJob {
  dedupKey      String             @id @db.Char(64)
  eventId       String             @unique @db.Uuid
  status        AftercareJobStatus @default(PENDING)
  attempts      Int                @default(0)
  leaseUntil    DateTime?
  leaseOwner    String?            @db.Uuid
  lastErrorCode String?            @db.VarChar(40)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([status, leaseUntil])
}

model FinancialJob {
  dedupKey      String             @id @db.Char(64)
  eventId       String             @unique @db.Uuid
  status        FinancialJobStatus @default(PENDING)
  attempts      Int                @default(0)
  leaseUntil    DateTime?
  leaseOwner    String?            @db.Uuid
  lastErrorCode String?            @db.VarChar(40)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([status, leaseUntil])
}

model User {
  id                      String                        @id @default(uuid()) @db.Uuid
  phone                   String                        @unique @db.VarChar(32)
  locale                  String                        @default("ru") @db.VarChar(8)
  displayName             String?                       @db.VarChar(160)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  roles                   UserRole[]
  sessions                Session[]
  challenges              OtpChallenge[]
  partner                 Partner?
  auditEvents             AuditEvent[]                  @relation("AuditActor")
  uploads                 UploadSession[]
  layouts                 LayoutRequest[]
  layoutApprovals         LayoutApproval[]
  manualReviews           ManualReview[]                @relation("ManualReviewOperator")
  tariffVersions          TariffVersion[]               @relation("TariffAuthor")
  orders                  Order[]
  capabilityVersions      BranchCapabilityVersion[]     @relation("CapabilityAuthor")
  operationalVersions     BranchOperationalVersion[]    @relation("OperationalVersionAuthor")
  catalogVersions         BranchCatalogVersion[]        @relation("CatalogVersionAuthor")
  capacityVersions        BranchCapacityVersion[]       @relation("CapacityVersionAuthor")
  availabilityChanges     BranchAvailabilityException[] @relation("AvailabilityAuthor")
  courierProfile          CourierProfile?
  printerAgentsCreated    PrinterAgent[]                @relation("PrinterAgentCreator")
  disputesOpened          DisputeCase[]                 @relation("DisputeOpener")
  disputeResponses        DisputeResponse[]             @relation("DisputeResponder")
  disputeResolutions      DisputeResolution[]           @relation("DisputeResolver")
  legalHoldsCreated       LegalHold[]                   @relation("LegalHoldCreator")
  legalHoldsReleased      LegalHold[]                   @relation("LegalHoldReleaser")
  settlementBatches       SettlementBatch[]             @relation("SettlementBatchCreator")
  reconciliations         FinancialReconciliation[]     @relation("ReconciliationActor")
  platformCatalogs        PlatformCatalogVersion[]      @relation("PlatformCatalogPublisher")
  orderDrafts             OrderDraft[]
  notifications           UserNotification[]
  studioListingsAuthored  StudioListingVersion[]        @relation("StudioListingAuthor")
  studioListingsModerated StudioListingVersion[]        @relation("StudioListingModerator")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(32)
  codeDigest  String    @db.Char(64)
  attempts    Int       @default(0)
  maxAttempts Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  familyId        String    @db.Uuid
  refreshDigest   String    @db.Char(64)
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?   @db.Uuid
  reuseDetectedAt DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model Partner {
  id                           String              @id @default(uuid()) @db.Uuid
  ownerId                      String              @unique @db.Uuid
  displayName                  String              @db.VarChar(180)
  publicDescription            String?             @db.VarChar(500)
  publicContact                String?             @db.VarChar(180)
  operationalContactCiphertext String?             @db.Text
  operationalContactIv         String?             @db.VarChar(24)
  operationalContactAuthTag    String?             @db.VarChar(32)
  status                       PartnerStatus       @default(PENDING)
  approvedAt                   DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  owner                        User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches                     Branch[]
  offers                       PartnerOffer[]
  assignments                  PartnerAssignment[]
  settlementBatches            SettlementBatch[]
}

model Branch {
  id                     String                         @id @default(uuid()) @db.Uuid
  partnerId              String                         @db.Uuid
  name                   String                         @db.VarChar(180)
  city                   String                         @default("Tashkent") @db.VarChar(100)
  district               String?                        @db.VarChar(120)
  locationCode           String                         @default("TASHKENT") @db.VarChar(40)
  publicDescription      String?                        @db.VarChar(500)
  timezone               String                         @default("Asia/Tashkent") @db.VarChar(64)
  latitude               Decimal                        @default(41.311081) @db.Decimal(9, 6)
  longitude              Decimal                        @default(69.240562) @db.Decimal(9, 6)
  serviceRadiusMeters    Int                            @default(25000)
  acceptingOrders        Boolean                        @default(true)
  active                 Boolean                        @default(true)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  partner                Partner                        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  capabilityVersions     BranchCapabilityVersion[]
  operationalVersions    BranchOperationalVersion[]
  catalogVersions        BranchCatalogVersion[]
  capacityVersions       BranchCapacityVersion[]
  availabilityExceptions BranchAvailabilityException[]
  candidateEvaluations   MatchingCandidateEvaluation[]
  capacityReservations   OfferCapacityReservation[]
  offers                 PartnerOffer[]
  assignments            PartnerAssignment[]
  printerAgents          PrinterAgent[]
  printJobs              PrintJob[]
  deliveryTasks          DeliveryTask[]
  studioListings         StudioListingVersion[]
  draftPreferences       OrderDraftStudioPreference[]
  selectionSnapshots     OrderStudioSelectionSnapshot[]
}

/// Moderated versioned public projection. Content is immutable after publication.
model StudioListingVersion {
  id                 String                         @id @default(uuid()) @db.Uuid
  branchId           String                         @db.Uuid
  sequence           Int
  publicSlug         String                         @db.VarChar(80)
  status             StudioListingStatus            @default(DRAFT)
  titleRu            String                         @db.VarChar(120)
  titleUz            String                         @db.VarChar(120)
  descriptionRu      String                         @db.VarChar(500)
  descriptionUz      String                         @db.VarChar(500)
  createdById        String                         @db.Uuid
  moderatedById      String?                        @db.Uuid
  moderationCode     String?                        @db.VarChar(40)
  submittedAt        DateTime?
  publishedAt        DateTime?
  retiredAt          DateTime?
  createdAt          DateTime                       @default(now())
  branch             Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User                           @relation("StudioListingAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  moderatedBy        User?                          @relation("StudioListingModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  draftPreferences   OrderDraftStudioPreference[]
  selectionSnapshots OrderStudioSelectionSnapshot[]

  @@unique([branchId, sequence])
  @@index([status, publicSlug])
  @@index([branchId, status, sequence])
}

/// Immutable, versioned matching capabilities. Retiring a version never edits it.
model BranchCapabilityVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  branchId             String                         @db.Uuid
  version              Int
  status               CapabilityStatus               @default(ACTIVE)
  supportedFileKinds   UploadFileKind[]
  maxPages             Int
  maxWidthMm           Int
  maxHeightMm          Int
  minDpi               Int
  priority             Int                            @default(100)
  serviceCodes         String[]                       @default(["DOCUMENT_PRINT"])
  paperCodes           String[]                       @default(["STANDARD"])
  colorModes           String[]                       @default(["COLOR", "MONOCHROME"])
  equipmentCodes       String[]                       @default([])
  maxQuantity          Int                            @default(1000)
  createdById          String                         @db.Uuid
  createdAt            DateTime                       @default(now())
  retiredAt            DateTime?
  branch               Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy            User                           @relation("CapabilityAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  offers               PartnerOffer[]
  candidateEvaluations MatchingCandidateEvaluation[]
  draftPreferences     OrderDraftStudioPreference[]
  selectionSnapshots   OrderStudioSelectionSnapshot[]

  @@unique([branchId, version])
  @@index([branchId, status])
}

/// Immutable branch hours/settings. weeklyHours uses bounded weekday/minute ranges.
model BranchOperationalVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  branchId             String                         @db.Uuid
  version              Int
  status               NetworkVersionStatus           @default(ACTIVE)
  weeklyHours          Json
  settings             Json
  createdById          String                         @db.Uuid
  createdAt            DateTime                       @default(now())
  retiredAt            DateTime?
  branch               Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy            User                           @relation("OperationalVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  candidateEvaluations MatchingCandidateEvaluation[]
  offers               PartnerOffer[]
  draftPreferences     OrderDraftStudioPreference[]
  selectionSnapshots   OrderStudioSelectionSnapshot[]

  @@unique([branchId, version])
  @@index([branchId, status])
}

model BranchCatalogVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  branchId             String                         @db.Uuid
  version              Int
  status               NetworkVersionStatus           @default(ACTIVE)
  createdById          String                         @db.Uuid
  createdAt            DateTime                       @default(now())
  retiredAt            DateTime?
  branch               Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy            User                           @relation("CatalogVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  items                BranchCatalogItem[]
  candidateEvaluations MatchingCandidateEvaluation[]
  offers               PartnerOffer[]
  draftPreferences     OrderDraftStudioPreference[]
  selectionSnapshots   OrderStudioSelectionSnapshot[]

  @@unique([branchId, version])
  @@index([branchId, status])
}

model BranchCatalogItem {
  id               String               @id @default(uuid()) @db.Uuid
  catalogVersionId String               @db.Uuid
  serviceCode      String               @db.VarChar(40)
  enabled          Boolean              @default(true)
  paperCodes       String[]             @default([])
  colorModes       String[]             @default([])
  maxQuantity      Int
  catalogVersion   BranchCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, serviceCode])
}

model BranchCapacityVersion {
  id                   String                         @id @default(uuid()) @db.Uuid
  branchId             String                         @db.Uuid
  version              Int
  status               NetworkVersionStatus           @default(ACTIVE)
  maxConcurrentOrders  Int
  createdById          String                         @db.Uuid
  createdAt            DateTime                       @default(now())
  retiredAt            DateTime?
  branch               Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy            User                           @relation("CapacityVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  candidateEvaluations MatchingCandidateEvaluation[]
  reservations         OfferCapacityReservation[]
  offers               PartnerOffer[]
  draftPreferences     OrderDraftStudioPreference[]
  selectionSnapshots   OrderStudioSelectionSnapshot[]

  @@unique([branchId, version])
  @@index([branchId, status])
}

model BranchAvailabilityException {
  id          String           @id @default(uuid()) @db.Uuid
  branchId    String           @db.Uuid
  kind        AvailabilityKind
  startsAt    DateTime
  endsAt      DateTime
  createdById String           @db.Uuid
  createdAt   DateTime         @default(now())
  cancelledAt DateTime?
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("AvailabilityAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, startsAt, endsAt])
}

/// Immutable published customer catalog. New versions supersede rather than edit.
model PlatformCatalogVersion {
  id          String                @id @default(uuid()) @db.Uuid
  version     Int                   @unique
  status      PlatformCatalogStatus @default(DRAFT)
  createdById String                @db.Uuid
  createdAt   DateTime              @default(now())
  publishedAt DateTime?
  retiredAt   DateTime?
  createdBy   User                  @relation("PlatformCatalogPublisher", fields: [createdById], references: [id], onDelete: Restrict)
  items       PlatformCatalogItem[]
  drafts      OrderDraft[]
  quotes      PriceQuote[]

  @@index([status, version])
}

model PlatformCatalogItem {
  id                String                 @id @default(uuid()) @db.Uuid
  catalogVersionId  String                 @db.Uuid
  serviceCode       String                 @db.VarChar(40)
  slug              String                 @db.VarChar(80)
  titleRu           String                 @db.VarChar(120)
  titleUz           String                 @db.VarChar(120)
  descriptionRu     String                 @db.VarChar(500)
  descriptionUz     String                 @db.VarChar(500)
  acceptedFileKinds UploadFileKind[]
  optionSchema      Json
  sortOrder         Int                    @default(100)
  enabled           Boolean                @default(true)
  catalogVersion    PlatformCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  drafts            OrderDraft[]
  quotes            PriceQuote[]

  @@unique([catalogVersionId, serviceCode])
  @@unique([catalogVersionId, slug])
  @@index([catalogVersionId, enabled, sortOrder])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  eventType  String   @db.VarChar(80)
  targetType String?  @db.VarChar(50)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
}

model BootstrapState {
  key       String   @id @db.VarChar(50)
  usedAt    DateTime
  createdAt DateTime @default(now())
}

/// Infrastructure record used by backup/retention. It does not expose uploads.
model PermanentObjectReference {
  objectKey      String                    @id @db.VarChar(1024)
  checksum       String                    @db.Char(64)
  retentionClass ObjectRetentionClass
  expiresAt      DateTime
  deletedAt      DateTime?
  createdAt      DateTime                  @default(now())
  schedules      RetentionScheduleObject[]

  @@index([expiresAt, deletedAt])
}

/// Deletion marker replayed before restored object storage is exposed.
model RetentionTombstone {
  objectKey     String               @id @db.VarChar(1024)
  deletedAt     DateTime             @default(now())
  reason        String?              @db.VarChar(80)
  applyStatus   TombstoneApplyStatus @default(PENDING)
  appliedAt     DateTime?
  attempts      Int                  @default(0)
  leaseUntil    DateTime?
  lastErrorCode String?              @db.VarChar(80)

  @@index([deletedAt])
}

/// A quota reservation and lifecycle record. Original filenames are never stored.
model UploadSession {
  id                  String             @id @default(uuid()) @db.Uuid
  fileVersion         String             @unique @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  fileKind            UploadFileKind
  declaredMime        String             @db.VarChar(100)
  expectedSizeBytes   BigInt
  actualSizeBytes     BigInt?
  sha256              String?            @db.Char(64)
  pageCount           Int?
  pixelCount          BigInt?
  status              UploadStatus       @default(CREATED)
  quarantineObjectKey String             @unique @db.VarChar(160)
  permanentObjectKey  String?            @unique @db.VarChar(160)
  version             Int                @default(0)
  expiresAt           DateTime
  cancelledAt         DateTime?
  completedAt         DateTime?
  rejectionCode       String?            @db.VarChar(80)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  processingJobs      ProcessingJob[]
  processingResults   ProcessingResult[]
  layout              LayoutRequest?
  orderDraft          OrderDraft?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model ProcessingJob {
  id               String              @id @default(uuid()) @db.Uuid
  uploadId         String              @db.Uuid
  operation        ProcessingOperation
  settingsHash     String              @db.Char(64)
  dedupKey         String              @unique @db.Char(64)
  resultObjectKey  String              @unique @db.VarChar(160)
  status           ProcessingJobStatus @default(PENDING)
  aggregateVersion Int
  attempts         Int                 @default(0)
  leaseOwner       String?             @db.VarChar(100)
  leaseUntil       DateTime?
  lastErrorCode    String?             @db.VarChar(80)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  upload           UploadSession       @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  result           ProcessingResult?

  @@index([status, leaseUntil])
}

model ProcessingResult {
  id                 String              @id @default(uuid()) @db.Uuid
  jobId              String              @unique @db.Uuid
  uploadId           String              @db.Uuid
  objectKey          String              @unique @db.VarChar(160)
  checksum           String              @db.Char(64)
  sizeBytes          BigInt
  pageCount          Int
  createdAt          DateTime            @default(now())
  job                ProcessingJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  upload             UploadSession       @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  previewVersions    PreviewVersion[]
  printReadyVersions PrintReadyVersion[]
}

/// Mutable pointer to the current layout revision; immutable artifacts live below.
model LayoutRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  uploadId           String              @unique @db.Uuid
  userId             String              @db.Uuid
  sourceFileVersion  String              @db.Uuid
  settingsHash       String              @db.Char(64)
  settings           Json
  status             LayoutStatus        @default(PROCESSING)
  version            Int                 @default(0)
  latestPreviewId    String?             @db.Uuid
  latestPrintReadyId String?             @db.Uuid
  currentApprovalId  String?             @db.Uuid
  qualityCode        String?             @db.VarChar(80)
  manualReviewReason String?             @db.VarChar(80)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  upload             UploadSession       @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  previews           PreviewVersion[]
  printReadyVersions PrintReadyVersion[]
  approvals          LayoutApproval[]
  manualReviews      ManualReview[]
  orders             Order[]
  orderDraft         OrderDraft?

  @@index([userId, status])
  @@index([status, updatedAt])
}

model PreviewVersion {
  id                       String           @id @default(uuid()) @db.Uuid
  layoutId                 String           @db.Uuid
  version                  Int
  objectKey                String           @unique @db.VarChar(160)
  checksum                 String           @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String           @db.Uuid
  settingsHash             String           @db.Char(64)
  originProcessingResultId String           @db.Uuid
  pageCount                Int
  createdAt                DateTime         @default(now())
  layout                   LayoutRequest    @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)
  approvals                LayoutApproval[]
  manualReview             ManualReview?

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model PrintReadyVersion {
  id                       String            @id @default(uuid()) @db.Uuid
  layoutId                 String            @db.Uuid
  version                  Int
  objectKey                String            @unique @db.VarChar(160)
  checksum                 String            @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String            @db.Uuid
  settingsHash             String            @db.Char(64)
  originProcessingResultId String            @db.Uuid
  pageCount                Int
  createdAt                DateTime          @default(now())
  layout                   LayoutRequest     @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult  @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)
  orders                   Order[]
  productionCycles         ProductionCycle[]

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model LayoutApproval {
  id               String         @id @default(uuid()) @db.Uuid
  layoutId         String         @db.Uuid
  previewVersionId String         @db.Uuid
  userId           String         @db.Uuid
  layoutVersion    Int
  createdAt        DateTime       @default(now())
  layout           LayoutRequest  @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order?
  orderDraft       OrderDraft?

  @@unique([layoutId, previewVersionId])
  @@index([userId, createdAt])
}

model TariffVersion {
  id                String          @id @default(uuid()) @db.Uuid
  version           Int             @unique
  status            TariffStatus    @default(ACTIVE)
  currency          String          @default("UZS") @db.Char(3)
  basePriceMinor    BigInt
  perPagePriceMinor BigInt
  createdById       String          @db.Uuid
  createdAt         DateTime        @default(now())
  retiredAt         DateTime?
  createdBy         User            @relation("TariffAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  priceSnapshots    PriceSnapshot[]
  rules             TariffRule[]
  quotes            PriceQuote[]

  @@index([status, version])
}

/// Immutable service-specific rule inside one tariff version.
model TariffRule {
  id                String        @id @default(uuid()) @db.Uuid
  tariffVersionId   String        @db.Uuid
  serviceCode       String        @db.VarChar(40)
  basePriceMinor    BigInt
  perPagePriceMinor BigInt
  optionPrices      Json
  createdAt         DateTime      @default(now())
  tariffVersion     TariffVersion @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)

  @@unique([tariffVersionId, serviceCode])
}

model OrderDraft {
  id               String                      @id @default(uuid()) @db.Uuid
  userId           String                      @db.Uuid
  catalogVersionId String                      @db.Uuid
  catalogItemId    String                      @db.Uuid
  serviceCode      String                      @db.VarChar(40)
  locale           String                      @default("ru") @db.VarChar(8)
  configuration    Json
  quantity         Int                         @default(1)
  status           OrderDraftStatus            @default(CONFIGURING)
  version          Int                         @default(0)
  uploadId         String?                     @unique @db.Uuid
  layoutId         String?                     @unique @db.Uuid
  layoutApprovalId String?                     @unique @db.Uuid
  expiresAt        DateTime
  cancelledAt      DateTime?
  checkedOutAt     DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  catalogVersion   PlatformCatalogVersion      @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  catalogItem      PlatformCatalogItem         @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  upload           UploadSession?              @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  layout           LayoutRequest?              @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  layoutApproval   LayoutApproval?             @relation(fields: [layoutApprovalId], references: [id], onDelete: Restrict)
  quotes           PriceQuote[]
  order            Order?
  studioPreference OrderDraftStudioPreference?

  @@index([userId, status, updatedAt])
  @@index([status, expiresAt])
}

/// Mutable CAS-protected preference owned by a resumable draft.
model OrderDraftStudioPreference {
  id                   String                    @id @default(uuid()) @db.Uuid
  draftId              String                    @unique @db.Uuid
  mode                 StudioPreferenceMode      @default(AUTO_ASSIGN)
  fallbackPolicy       StudioFallbackPolicy      @default(ALLOW_ELIGIBLE_ALTERNATIVE)
  listingId            String?                   @db.Uuid
  branchId             String?                   @db.Uuid
  capabilityVersionId  String?                   @db.Uuid
  operationalVersionId String?                   @db.Uuid
  catalogVersionId     String?                   @db.Uuid
  capacityVersionId    String?                   @db.Uuid
  version              Int                       @default(0)
  invalidatedAt        DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  draft                OrderDraft                @relation(fields: [draftId], references: [id], onDelete: Restrict)
  listing              StudioListingVersion?     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  branch               Branch?                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capabilityVersion    BranchCapabilityVersion?  @relation(fields: [capabilityVersionId], references: [id], onDelete: Restrict)
  operationalVersion   BranchOperationalVersion? @relation(fields: [operationalVersionId], references: [id], onDelete: Restrict)
  catalogVersion       BranchCatalogVersion?     @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  capacityVersion      BranchCapacityVersion?    @relation(fields: [capacityVersionId], references: [id], onDelete: Restrict)

  @@index([branchId, mode])
}

model PriceQuote {
  id               String                 @id @default(uuid()) @db.Uuid
  draftId          String                 @db.Uuid
  sequence         Int
  draftVersion     Int
  catalogVersionId String                 @db.Uuid
  catalogItemId    String                 @db.Uuid
  tariffVersionId  String                 @db.Uuid
  tariffVersion    Int
  layoutVersion    Int
  layoutApprovalId String                 @db.Uuid
  sourceParameters Json
  lineItems        Json
  quantity         Int
  subtotalMinor    BigInt
  discountMinor    BigInt                 @default(0)
  totalMinor       BigInt
  currency         String                 @default("UZS") @db.Char(3)
  status           PriceQuoteStatus       @default(ACTIVE)
  expiresAt        DateTime
  createdAt        DateTime               @default(now())
  consumedAt       DateTime?
  draft            OrderDraft             @relation(fields: [draftId], references: [id], onDelete: Restrict)
  catalogVersion   PlatformCatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  catalogItem      PlatformCatalogItem    @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  tariff           TariffVersion          @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)
  order            Order?

  @@unique([draftId, sequence])
  @@index([draftId, status, expiresAt])
}

model Order {
  id                  String                        @id @default(uuid()) @db.Uuid
  userId              String                        @db.Uuid
  layoutId            String                        @db.Uuid
  layoutApprovalId    String                        @unique @db.Uuid
  printReadyVersionId String                        @db.Uuid
  status              OrderStatus                   @default(AWAITING_PAYMENT)
  version             Int                           @default(0)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  disputeEligibleAt   DateTime?
  orderDraftId        String?                       @unique @db.Uuid
  priceQuoteId        String?                       @unique @db.Uuid
  user                User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  layout              LayoutRequest                 @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  layoutApproval      LayoutApproval                @relation(fields: [layoutApprovalId], references: [id], onDelete: Restrict)
  printReadyVersion   PrintReadyVersion             @relation(fields: [printReadyVersionId], references: [id], onDelete: Restrict)
  priceSnapshot       PriceSnapshot?
  payment             Payment?
  matching            OrderMatching?
  partnerOffers       PartnerOffer[]
  assignments         PartnerAssignment[]
  fulfillments        OrderFulfillment[]
  printJobs           PrintJob[]
  deliveryTasks       DeliveryTask[]
  productionCycles    ProductionCycle[]
  disputes            DisputeCase[]
  retentionSchedules  RetentionSchedule[]
  legalHolds          LegalHold[]
  fiscalOperations    FiscalOperation[]
  partnerLedger       PartnerLedgerEntry[]
  orderDraft          OrderDraft?                   @relation(fields: [orderDraftId], references: [id], onDelete: Restrict)
  priceQuote          PriceQuote?                   @relation(fields: [priceQuoteId], references: [id], onDelete: Restrict)
  customerEvents      CustomerOrderEvent[]
  studioSelection     OrderStudioSelectionSnapshot?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Immutable checkout-time customer selection and Stage 10 lineage.
model OrderStudioSelectionSnapshot {
  id                   String                    @id @default(uuid()) @db.Uuid
  orderId              String                    @unique @db.Uuid
  mode                 StudioPreferenceMode
  fallbackPolicy       StudioFallbackPolicy
  listingId            String?                   @db.Uuid
  branchId             String?                   @db.Uuid
  listingSequence      Int?
  capabilityVersionId  String?                   @db.Uuid
  operationalVersionId String?                   @db.Uuid
  catalogVersionId     String?                   @db.Uuid
  capacityVersionId    String?                   @db.Uuid
  createdAt            DateTime                  @default(now())
  order                Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  listing              StudioListingVersion?     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  branch               Branch?                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capabilityVersion    BranchCapabilityVersion?  @relation(fields: [capabilityVersionId], references: [id], onDelete: Restrict)
  operationalVersion   BranchOperationalVersion? @relation(fields: [operationalVersionId], references: [id], onDelete: Restrict)
  catalogVersion       BranchCatalogVersion?     @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  capacityVersion      BranchCapacityVersion?    @relation(fields: [capacityVersionId], references: [id], onDelete: Restrict)

  @@index([branchId, mode])
}

model CustomerOrderEvent {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  outboxEventId String      @unique @db.Uuid
  sequence      Int
  eventCode     String      @db.VarChar(80)
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
}

model UserNotification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  outboxEventId String             @db.Uuid
  eventCode     String             @db.VarChar(80)
  titleKey      String             @db.VarChar(80)
  bodyKey       String             @db.VarChar(80)
  status        NotificationStatus @default(UNREAD)
  createdAt     DateTime           @default(now())
  readAt        DateTime?
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  outboxEvent   OutboxEvent        @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@unique([userId, outboxEventId])
  @@index([userId, status, createdAt])
}

model NotificationJob {
  id            String                @id @default(uuid()) @db.Uuid
  outboxEventId String                @unique @db.Uuid
  dedupKey      String                @unique @db.Char(64)
  status        NotificationJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  leaseOwner    String?               @db.VarChar(100)
  leaseUntil    DateTime?
  lastErrorCode String?               @db.VarChar(80)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  outboxEvent   OutboxEvent           @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)

  @@index([status, leaseUntil])
}

/// Courier onboarding is role-gated independently from partner ownership.
model CourierProfile {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @unique @db.Uuid
  displayName String         @db.VarChar(160)
  serviceZone String         @db.VarChar(40)
  status      CourierStatus  @default(PENDING)
  active      Boolean        @default(true)
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries  DeliveryTask[]

  @@index([status, active, serviceZone])
}

/// One fulfillment aggregate per order. PIN material is derived from a secret and opaque nonce.
model OrderFulfillment {
  id                  String            @id @default(uuid()) @db.Uuid
  orderId             String            @db.Uuid
  productionCycleId   String            @unique @db.Uuid
  mode                FulfillmentMode
  status              FulfillmentStatus @default(AWAITING_HANDOFF)
  requestKeyDigest    String            @db.Char(64)
  requestHash         String            @db.Char(64)
  completionNonce     String            @db.Char(32)
  completionPinDigest String            @db.Char(64)
  completionAttempts  Int               @default(0)
  completionExpiresAt DateTime
  completionUsedAt    DateTime?
  handoffNonce        String?           @db.Char(32)
  handoffPinDigest    String?           @db.Char(64)
  handoffAttempts     Int               @default(0)
  handoffUsedAt       DateTime?
  addressCiphertext   String?           @db.Text
  addressIv           String?           @db.VarChar(24)
  addressAuthTag      String?           @db.VarChar(32)
  version             Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productionCycle     ProductionCycle   @relation(fields: [productionCycleId], references: [id], onDelete: Restrict)
  delivery            DeliveryTask?

  @@unique([productionCycleId, requestKeyDigest])
  @@index([status, completionExpiresAt])
}

model DeliveryTask {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @db.Uuid
  fulfillmentId     String           @unique @db.Uuid
  courierId         String           @db.Uuid
  branchId          String           @db.Uuid
  providerReference String           @unique @db.VarChar(160)
  status            DeliveryStatus   @default(ASSIGNED)
  active            Boolean          @default(true)
  version           Int              @default(0)
  assignedAt        DateTime         @default(now())
  pickedUpAt        DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureCode       String?          @db.VarChar(40)
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfillment       OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  courier           CourierProfile   @relation(fields: [courierId], references: [id], onDelete: Restrict)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([courierId, active, assignedAt])
  @@index([status, assignedAt])
}

/// Machine identity for the branch-local printer agent. Only a token digest is stored.
model PrinterAgent {
  id          String             @id @default(uuid()) @db.Uuid
  branchId    String             @db.Uuid
  label       String             @db.VarChar(80)
  tokenDigest String             @unique @db.Char(64)
  status      PrinterAgentStatus @default(ACTIVE)
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("PrinterAgentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  jobs        PrintJob[]

  @@index([branchId, status])
}

model PrintJob {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @db.Uuid
  productionCycleId String            @unique @db.Uuid
  assignmentId      String            @db.Uuid
  branchId          String            @db.Uuid
  agentId           String?           @db.Uuid
  status            PrintJobStatus    @default(PENDING)
  version           Int               @default(0)
  attempts          Int               @default(0)
  leaseUntil        DateTime?
  failureCode       String?           @db.VarChar(40)
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productionCycle   ProductionCycle   @relation(fields: [productionCycleId], references: [id], onDelete: Restrict)
  assignment        PartnerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agent             PrinterAgent?     @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([branchId, status, createdAt])
  @@index([agentId, status])
}

model OrderMatching {
  id          String                        @id @default(uuid()) @db.Uuid
  orderId     String                        @unique @db.Uuid
  status      MatchingStatus                @default(ACTIVE)
  version     Int                           @default(0)
  startedAt   DateTime                      @default(now())
  exhaustedAt DateTime?
  assignedAt  DateTime?
  order       Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  evaluations MatchingCandidateEvaluation[]
}

model MatchingCandidateEvaluation {
  id                   String                    @id @default(uuid()) @db.Uuid
  matchingId           String                    @db.Uuid
  branchId             String                    @db.Uuid
  evaluationRound      Int                       @default(0)
  capabilityVersionId  String?                   @db.Uuid
  operationalVersionId String?                   @db.Uuid
  catalogVersionId     String?                   @db.Uuid
  capacityVersionId    String?                   @db.Uuid
  reasonCodes          MatchingReasonCode[]
  eligible             Boolean
  candidateRank        Int?
  priority             Int?
  distanceMeters       Int?
  workloadBasisPoints  Int?
  createdAt            DateTime                  @default(now())
  matching             OrderMatching             @relation(fields: [matchingId], references: [id], onDelete: Restrict)
  branch               Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capabilityVersion    BranchCapabilityVersion?  @relation(fields: [capabilityVersionId], references: [id], onDelete: Restrict)
  operationalVersion   BranchOperationalVersion? @relation(fields: [operationalVersionId], references: [id], onDelete: Restrict)
  catalogVersion       BranchCatalogVersion?     @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  capacityVersion      BranchCapacityVersion?    @relation(fields: [capacityVersionId], references: [id], onDelete: Restrict)
  offer                PartnerOffer?

  @@unique([matchingId, branchId, evaluationRound])
  @@index([matchingId, eligible, candidateRank])
}

model PartnerOffer {
  id                   String                       @id @default(uuid()) @db.Uuid
  orderId              String                       @db.Uuid
  partnerId            String                       @db.Uuid
  branchId             String                       @db.Uuid
  capabilityVersionId  String                       @db.Uuid
  operationalVersionId String?                      @db.Uuid
  catalogVersionId     String?                      @db.Uuid
  capacityVersionId    String?                      @db.Uuid
  evaluationId         String?                      @unique @db.Uuid
  candidateRank        Int
  status               PartnerOfferStatus           @default(PENDING)
  version              Int                          @default(0)
  expiresAt            DateTime
  decidedAt            DateTime?
  createdAt            DateTime                     @default(now())
  order                Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner              Partner                      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch               Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capabilityVersion    BranchCapabilityVersion      @relation(fields: [capabilityVersionId], references: [id], onDelete: Restrict)
  operationalVersion   BranchOperationalVersion?    @relation(fields: [operationalVersionId], references: [id], onDelete: Restrict)
  catalogVersion       BranchCatalogVersion?        @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)
  capacityVersion      BranchCapacityVersion?       @relation(fields: [capacityVersionId], references: [id], onDelete: Restrict)
  evaluation           MatchingCandidateEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  payoutSnapshot       PartnerPayoutSnapshot?
  assignment           PartnerAssignment?
  capacityReservation  OfferCapacityReservation?

  @@unique([orderId, branchId])
  @@index([partnerId, status, expiresAt])
  @@index([status, expiresAt])
}

model OfferCapacityReservation {
  id                String                    @id @default(uuid()) @db.Uuid
  offerId           String                    @unique @db.Uuid
  branchId          String                    @db.Uuid
  capacityVersionId String                    @db.Uuid
  status            CapacityReservationStatus @default(HELD)
  expiresAt         DateTime
  consumedAt        DateTime?
  releasedAt        DateTime?
  createdAt         DateTime                  @default(now())
  offer             PartnerOffer              @relation(fields: [offerId], references: [id], onDelete: Restrict)
  branch            Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capacityVersion   BranchCapacityVersion     @relation(fields: [capacityVersionId], references: [id], onDelete: Restrict)

  @@index([branchId, status, expiresAt])
}

/// Financial terms are append-only and never updated after offer creation.
model PartnerPayoutSnapshot {
  id                  String               @id @default(uuid()) @db.Uuid
  offerId             String               @unique @db.Uuid
  customerAmountMinor BigInt
  partnerPayoutMinor  BigInt
  agatCommissionMinor BigInt
  currency            String               @default("UZS") @db.Char(3)
  ruleVersion         String               @db.VarChar(40)
  calculationInputs   Json
  createdAt           DateTime             @default(now())
  offer               PartnerOffer         @relation(fields: [offerId], references: [id], onDelete: Restrict)
  assignment          PartnerAssignment?
  ledgerEntries       PartnerLedgerEntry[]
}

model PartnerAssignment {
  id               String                @id @default(uuid()) @db.Uuid
  orderId          String                @db.Uuid
  offerId          String                @unique @db.Uuid
  partnerId        String                @db.Uuid
  branchId         String                @db.Uuid
  payoutSnapshotId String                @unique @db.Uuid
  status           AssignmentStatus      @default(ACTIVE)
  active           Boolean               @default(true)
  version          Int                   @default(0)
  acceptedAt       DateTime              @default(now())
  readyAt          DateTime?
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offer            PartnerOffer          @relation(fields: [offerId], references: [id], onDelete: Restrict)
  partner          Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch           Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payoutSnapshot   PartnerPayoutSnapshot @relation(fields: [payoutSnapshotId], references: [id], onDelete: Restrict)
  printJobs        PrintJob[]
  productionCycles ProductionCycle[]
  ledgerEntries    PartnerLedgerEntry[]

  @@index([orderId, active])
  @@index([partnerId, active])
}

model PriceSnapshot {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @db.Uuid
  tariffVersionId  String        @db.Uuid
  tariffVersion    Int
  sourceParameters Json
  lineItems        Json
  quantity         Int
  subtotalMinor    BigInt
  discountMinor    BigInt        @default(0)
  totalMinor       BigInt
  currency         String        @db.Char(3)
  createdAt        DateTime      @default(now())
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tariff           TariffVersion @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)
}

model Payment {
  id                       String            @id @default(uuid()) @db.Uuid
  orderId                  String            @unique @db.Uuid
  provider                 String            @db.VarChar(30)
  providerPaymentReference String?           @unique @db.VarChar(160)
  amountMinor              BigInt
  currency                 String            @db.Char(3)
  status                   PaymentStatus     @default(PENDING)
  version                  Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  order                    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds                  RefundOperation[]
  fiscalOperations         FiscalOperation[]

  @@index([status, updatedAt])
}

model RefundOperation {
  id                      String              @id @default(uuid()) @db.Uuid
  paymentId               String              @db.Uuid
  disputeId               String?             @unique @db.Uuid
  kind                    RefundKind          @default(FULL)
  triggerDedupKey         String              @unique @db.Char(64)
  providerRefundReference String?             @unique @db.VarChar(160)
  amountMinor             BigInt
  status                  RefundStatus        @default(REQUESTED)
  createdAt               DateTime            @default(now())
  confirmedAt             DateTime?
  payment                 Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  dispute                 DisputeCase?        @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  fiscalOperation         FiscalOperation?
  ledgerEntry             PartnerLedgerEntry?

  @@index([paymentId, status])
}

model DisputeCase {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  sequence          Int
  openedById        String             @db.Uuid
  category          DisputeCategory
  structuredComment String?            @db.VarChar(280)
  status            DisputeStatus      @default(OPEN)
  openedFromStatus  OrderStatus
  expiresAt         DateTime
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  resolvedAt        DateTime?
  cancelledAt       DateTime?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy          User               @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  responses         DisputeResponse[]
  resolution        DisputeResolution?
  refunds           RefundOperation?
  legalHold         LegalHold?

  @@unique([orderId, sequence])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model DisputeResponse {
  id           String      @id @default(uuid()) @db.Uuid
  disputeId    String      @db.Uuid
  responderId  String      @db.Uuid
  responseCode String      @db.VarChar(40)
  createdAt    DateTime    @default(now())
  dispute      DisputeCase @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  responder    User        @relation("DisputeResponder", fields: [responderId], references: [id], onDelete: Restrict)

  @@unique([disputeId, responderId])
}

/// Append-only decision. Database triggers reject updates and deletes.
model DisputeResolution {
  id                String                @id @default(uuid()) @db.Uuid
  disputeId         String                @unique @db.Uuid
  resolverId        String                @db.Uuid
  type              DisputeResolutionType
  refundAmountMinor BigInt?
  currency          String?               @db.Char(3)
  ruleVersion       String                @db.VarChar(40)
  allocationInputs  Json
  createdAt         DateTime              @default(now())
  dispute           DisputeCase           @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  resolver          User                  @relation("DisputeResolver", fields: [resolverId], references: [id], onDelete: Restrict)
  productionCycle   ProductionCycle?
}

model ProductionCycle {
  id                  String                @id @default(uuid()) @db.Uuid
  orderId             String                @db.Uuid
  sequence            Int
  kind                ProductionCycleKind
  status              ProductionCycleStatus @default(CREATED)
  printReadyVersionId String                @db.Uuid
  assignmentId        String                @db.Uuid
  resolutionId        String?               @unique @db.Uuid
  version             Int                   @default(0)
  createdAt           DateTime              @default(now())
  completedAt         DateTime?
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  printReadyVersion   PrintReadyVersion     @relation(fields: [printReadyVersionId], references: [id], onDelete: Restrict)
  assignment          PartnerAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  resolution          DisputeResolution?    @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  printJob            PrintJob?
  fulfillment         OrderFulfillment?

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

model RetentionPolicy {
  id             String              @id @default(uuid()) @db.Uuid
  version        Int                 @unique
  originalDays   Int
  derivativeDays Int
  auditDays      Int
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  schedules      RetentionSchedule[]
}

model RetentionSchedule {
  id              String                    @id @default(uuid()) @db.Uuid
  orderId         String                    @db.Uuid
  policyId        String                    @db.Uuid
  terminalVersion Int
  status          RetentionScheduleStatus   @default(ACTIVE)
  terminalAt      DateTime
  createdAt       DateTime                  @default(now())
  completedAt     DateTime?
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  policy          RetentionPolicy           @relation(fields: [policyId], references: [id], onDelete: Restrict)
  objects         RetentionScheduleObject[]

  @@unique([orderId, terminalVersion])
  @@index([status, terminalAt])
}

model RetentionScheduleObject {
  scheduleId String                   @db.Uuid
  objectKey  String                   @db.VarChar(1024)
  expiresAt  DateTime
  schedule   RetentionSchedule        @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  object     PermanentObjectReference @relation(fields: [objectKey], references: [objectKey], onDelete: Restrict)

  @@id([scheduleId, objectKey])
  @@index([expiresAt])
}

model LegalHold {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @db.Uuid
  disputeId    String?      @unique @db.Uuid
  reasonCode   String       @db.VarChar(40)
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())
  releasedById String?      @db.Uuid
  releasedAt   DateTime?
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  dispute      DisputeCase? @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("LegalHoldCreator", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy   User?        @relation("LegalHoldReleaser", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([orderId, releasedAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(80)
  keyDigest   String   @db.Char(64)
  requestHash String   @db.Char(64)
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, keyDigest])
  @@index([expiresAt])
}

model ProviderCallback {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(30)
  eventId     String   @db.Uuid
  payloadHash String   @db.Char(64)
  result      Json
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

/// Durable fiscal intent. Provider references are never returned by public API.
model FiscalOperation {
  id                String                @id @default(uuid()) @db.Uuid
  orderId           String                @db.Uuid
  paymentId         String                @db.Uuid
  refundId          String?               @unique @db.Uuid
  type              FiscalOperationType
  amountMinor       BigInt
  currency          String                @db.Char(3)
  status            FiscalOperationStatus @default(PENDING)
  dedupKey          String                @unique @db.Char(64)
  providerReference String?               @unique @db.VarChar(160)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime?
  lastErrorCode     String?               @db.VarChar(40)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  confirmedAt       DateTime?
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund            RefundOperation?      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  receipt           FiscalReceipt?

  @@index([status, nextAttemptAt])
  @@index([orderId, createdAt])
}

/// Receipt facts are append-only after provider confirmation.
model FiscalReceipt {
  id                    String          @id @default(uuid()) @db.Uuid
  fiscalOperationId     String          @unique @db.Uuid
  providerReceiptDigest String          @db.Char(64)
  fiscalSignDigest      String?         @db.Char(64)
  issuedAt              DateTime
  createdAt             DateTime        @default(now())
  operation             FiscalOperation @relation(fields: [fiscalOperationId], references: [id], onDelete: Restrict)
}

/// Append-only partner balance movements; amount is always positive and direction carries the sign.
model PartnerLedgerEntry {
  id               String                @id @default(uuid()) @db.Uuid
  orderId          String                @db.Uuid
  assignmentId     String                @db.Uuid
  payoutSnapshotId String                @db.Uuid
  refundId         String?               @unique @db.Uuid
  type             LedgerEntryType
  direction        LedgerDirection
  amountMinor      BigInt
  currency         String                @db.Char(3)
  dedupKey         String                @unique @db.Char(64)
  createdAt        DateTime              @default(now())
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignment       PartnerAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  payoutSnapshot   PartnerPayoutSnapshot @relation(fields: [payoutSnapshotId], references: [id], onDelete: Restrict)
  refund           RefundOperation?      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  settlementItem   SettlementBatchItem?

  @@index([assignmentId, createdAt])
  @@index([orderId, createdAt])
}

model SettlementBatch {
  id                String                @id @default(uuid()) @db.Uuid
  partnerId         String                @db.Uuid
  sequence          Int                   @unique @default(autoincrement())
  currency          String                @db.Char(3)
  status            SettlementBatchStatus @default(CREATED)
  cutoffAt          DateTime
  totalMinor        BigInt
  dedupKey          String                @unique @db.Char(64)
  providerReference String?               @unique @db.VarChar(160)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime?
  lastErrorCode     String?               @db.VarChar(40)
  createdById       String                @db.Uuid
  createdAt         DateTime              @default(now())
  submittedAt       DateTime?
  settledAt         DateTime?
  createdBy         User                  @relation("SettlementBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  partner           Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  items             SettlementBatchItem[]

  @@index([status, nextAttemptAt])
  @@index([partnerId, createdAt])
}

model SettlementBatchItem {
  batchId       String             @db.Uuid
  ledgerEntryId String             @unique @db.Uuid
  amountMinor   BigInt
  createdAt     DateTime           @default(now())
  batch         SettlementBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  ledgerEntry   PartnerLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@id([batchId, ledgerEntryId])
}

/// Every run records its observation. Mismatches require an explicit later resolution.
model FinancialReconciliation {
  id             String               @id @default(uuid()) @db.Uuid
  kind           ReconciliationKind
  entityId       String               @db.Uuid
  runKeyDigest   String               @db.Char(64)
  expectedStatus String               @db.VarChar(40)
  observedStatus String               @db.VarChar(40)
  status         ReconciliationStatus
  detailCode     String?              @db.VarChar(40)
  actorId        String?              @db.Uuid
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  actor          User?                @relation("ReconciliationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([kind, entityId, runKeyDigest])
  @@index([status, createdAt])
}

model ManualReview {
  id               String             @id @default(uuid()) @db.Uuid
  layoutId         String             @db.Uuid
  previewVersionId String             @unique @db.Uuid
  status           ManualReviewStatus @default(PENDING)
  reason           String             @db.VarChar(80)
  reviewerId       String?            @db.Uuid
  decisionAt       DateTime?
  version          Int                @default(0)
  createdAt        DateTime           @default(now())
  layout           LayoutRequest      @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion     @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  reviewer         User?              @relation("ManualReviewOperator", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model OutboxEvent {
  id               String              @id @default(uuid()) @db.Uuid
  aggregateType    String              @db.VarChar(50)
  aggregateId      String              @db.Uuid
  aggregateVersion Int
  eventType        String              @db.VarChar(80)
  dedupKey         String              @unique @db.Char(64)
  payload          Json
  createdAt        DateTime            @default(now())
  publishedAt      DateTime?
  notifications    UserNotification[]
  notificationJob  NotificationJob?
  customerEvent    CustomerOrderEvent?

  @@index([publishedAt, createdAt])
}

model InboxOperation {
  dedupKey    String   @id @db.Char(64)
  operation   String   @db.VarChar(80)
  completedAt DateTime @default(now())
  resultId    String?  @db.Uuid
}
