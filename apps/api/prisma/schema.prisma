generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  COURIER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ObjectRetentionClass {
  ORIGINAL
  PREVIEW
  DERIVATIVE
  PRINT_READY
}

enum UploadFileKind {
  PDF
  DOCX
  JPEG
  PNG
}

enum UploadStatus {
  CREATED
  QUARANTINED
  SCANNING
  QUEUED
  PROCESSING
  READY
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

enum ProcessingOperation {
  NORMALIZE
  PREFLIGHT
}

enum LayoutStatus {
  PROCESSING
  QUALITY_CHECK_FAILED
  MANUAL_REVIEW_REQUIRED
  AWAITING_APPROVAL
  APPROVED
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum TariffStatus {
  ACTIVE
  RETIRED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  MATCHING
  PARTNER_OFFERED
  PARTNER_ACCEPTED
  IN_PRODUCTION
  READY
  AWAITING_PICKUP
  COURIER_ASSIGNED
  IN_DELIVERY
  DELIVERY_FAILED
  COMPLETED
  REFUND_PENDING
  REFUNDED
}

enum CourierStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum FulfillmentMode {
  PICKUP
  DELIVERY
}

enum FulfillmentStatus {
  AWAITING_HANDOFF
  IN_DELIVERY
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  ASSIGNED
  IN_DELIVERY
  DELIVERED
  FAILED
}

enum PrinterAgentStatus {
  ACTIVE
  REVOKED
}

enum PrintJobStatus {
  PENDING
  LEASED
  PRINTING
  COMPLETED
  FAILED
  CANCELLED
}

enum CapabilityStatus {
  ACTIVE
  RETIRED
}

enum MatchingStatus {
  ACTIVE
  ASSIGNED
  EXHAUSTED
}

enum PartnerOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AssignmentStatus {
  ACTIVE
  READY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  CONFIRMED
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  phone       String         @unique @db.VarChar(32)
  locale      String         @default("ru") @db.VarChar(8)
  displayName String?        @db.VarChar(160)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roles       UserRole[]
  sessions    Session[]
  challenges OtpChallenge[]
  partner     Partner?
  auditEvents AuditEvent[]   @relation("AuditActor")
  uploads     UploadSession[]
  layouts     LayoutRequest[]
  layoutApprovals LayoutApproval[]
  manualReviews ManualReview[] @relation("ManualReviewOperator")
  tariffVersions TariffVersion[] @relation("TariffAuthor")
  orders      Order[]
  capabilityVersions BranchCapabilityVersion[] @relation("CapabilityAuthor")
  courierProfile CourierProfile?
  printerAgentsCreated PrinterAgent[] @relation("PrinterAgentCreator")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(32)
  codeDigest  String    @db.Char(64)
  attempts    Int       @default(0)
  maxAttempts Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshDigest    String    @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid
  reuseDetectedAt  DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model Partner {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @unique @db.Uuid
  displayName String        @db.VarChar(180)
  status      PartnerStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches    Branch[]
  offers      PartnerOffer[]
  assignments PartnerAssignment[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  name      String   @db.VarChar(180)
  city      String   @default("Tashkent") @db.VarChar(100)
  district  String?  @db.VarChar(120)
  locationCode String @default("TASHKENT") @db.VarChar(40)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  capabilityVersions BranchCapabilityVersion[]
  offers PartnerOffer[]
  assignments PartnerAssignment[]
  printerAgents PrinterAgent[]
  printJobs PrintJob[]
  deliveryTasks DeliveryTask[]
}

/// Immutable, versioned matching capabilities. Retiring a version never edits it.
model BranchCapabilityVersion {
  id                 String           @id @default(uuid()) @db.Uuid
  branchId           String           @db.Uuid
  version            Int
  status             CapabilityStatus @default(ACTIVE)
  supportedFileKinds UploadFileKind[]
  maxPages           Int
  maxWidthMm         Int
  maxHeightMm        Int
  minDpi             Int
  priority           Int              @default(100)
  createdById        String           @db.Uuid
  createdAt          DateTime         @default(now())
  retiredAt          DateTime?
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("CapabilityAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  offers             PartnerOffer[]

  @@unique([branchId, version])
  @@index([branchId, status])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  eventType  String   @db.VarChar(80)
  targetType String?  @db.VarChar(50)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
}

model BootstrapState {
  key       String   @id @db.VarChar(50)
  usedAt    DateTime
  createdAt DateTime @default(now())
}

/// Infrastructure record used by backup/retention. It does not expose uploads.
model PermanentObjectReference {
  objectKey      String               @id @db.VarChar(1024)
  checksum       String               @db.Char(64)
  retentionClass ObjectRetentionClass
  expiresAt      DateTime
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())

  @@index([expiresAt, deletedAt])
}

/// Deletion marker replayed before restored object storage is exposed.
model RetentionTombstone {
  objectKey String   @id @db.VarChar(1024)
  deletedAt DateTime @default(now())
  reason    String?  @db.VarChar(80)

  @@index([deletedAt])
}

/// A quota reservation and lifecycle record. Original filenames are never stored.
model UploadSession {
  id                  String         @id @default(uuid()) @db.Uuid
  fileVersion         String         @unique @default(uuid()) @db.Uuid
  userId              String         @db.Uuid
  fileKind            UploadFileKind
  declaredMime        String         @db.VarChar(100)
  expectedSizeBytes   BigInt
  actualSizeBytes     BigInt?
  sha256              String?        @db.Char(64)
  pageCount           Int?
  pixelCount          BigInt?
  status              UploadStatus   @default(CREATED)
  quarantineObjectKey String         @unique @db.VarChar(160)
  permanentObjectKey  String?        @unique @db.VarChar(160)
  version             Int            @default(0)
  expiresAt           DateTime
  cancelledAt         DateTime?
  completedAt         DateTime?
  rejectionCode       String?        @db.VarChar(80)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  processingJobs      ProcessingJob[]
  processingResults   ProcessingResult[]
  layout               LayoutRequest?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model ProcessingJob {
  id           String              @id @default(uuid()) @db.Uuid
  uploadId     String              @db.Uuid
  operation    ProcessingOperation
  settingsHash String              @db.Char(64)
  dedupKey     String              @unique @db.Char(64)
  resultObjectKey String           @unique @db.VarChar(160)
  status       ProcessingJobStatus @default(PENDING)
  aggregateVersion Int
  attempts     Int                 @default(0)
  leaseOwner   String?             @db.VarChar(100)
  leaseUntil   DateTime?
  lastErrorCode String?            @db.VarChar(80)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  upload       UploadSession       @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  result       ProcessingResult?

  @@index([status, leaseUntil])
}

model ProcessingResult {
  id         String          @id @default(uuid()) @db.Uuid
  jobId      String          @unique @db.Uuid
  uploadId   String          @db.Uuid
  objectKey  String          @unique @db.VarChar(160)
  checksum   String          @db.Char(64)
  sizeBytes  BigInt
  pageCount  Int
  createdAt  DateTime        @default(now())
  job        ProcessingJob   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  upload     UploadSession   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  previewVersions PreviewVersion[]
  printReadyVersions PrintReadyVersion[]
}

/// Mutable pointer to the current layout revision; immutable artifacts live below.
model LayoutRequest {
  id                   String       @id @default(uuid()) @db.Uuid
  uploadId             String       @unique @db.Uuid
  userId               String       @db.Uuid
  sourceFileVersion    String       @db.Uuid
  settingsHash         String       @db.Char(64)
  settings             Json
  status               LayoutStatus @default(PROCESSING)
  version              Int          @default(0)
  latestPreviewId      String?      @db.Uuid
  latestPrintReadyId   String?      @db.Uuid
  currentApprovalId    String?      @db.Uuid
  qualityCode          String?      @db.VarChar(80)
  manualReviewReason   String?      @db.VarChar(80)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  upload               UploadSession @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  previews             PreviewVersion[]
  printReadyVersions   PrintReadyVersion[]
  approvals            LayoutApproval[]
  manualReviews        ManualReview[]
  orders               Order[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model PreviewVersion {
  id                       String   @id @default(uuid()) @db.Uuid
  layoutId                 String   @db.Uuid
  version                  Int
  objectKey                String   @unique @db.VarChar(160)
  checksum                 String   @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String   @db.Uuid
  settingsHash             String   @db.Char(64)
  originProcessingResultId String   @db.Uuid
  pageCount                Int
  createdAt                DateTime @default(now())
  layout                   LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)
  approvals                LayoutApproval[]
  manualReview             ManualReview?

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model PrintReadyVersion {
  id                       String   @id @default(uuid()) @db.Uuid
  layoutId                 String   @db.Uuid
  version                  Int
  objectKey                String   @unique @db.VarChar(160)
  checksum                 String   @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String   @db.Uuid
  settingsHash             String   @db.Char(64)
  originProcessingResultId String   @db.Uuid
  pageCount                Int
  createdAt                DateTime @default(now())
  layout                   LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)
  orders                   Order[]

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model LayoutApproval {
  id               String   @id @default(uuid()) @db.Uuid
  layoutId         String   @db.Uuid
  previewVersionId String   @db.Uuid
  userId           String   @db.Uuid
  layoutVersion    Int
  createdAt        DateTime @default(now())
  layout           LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  user             User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order?

  @@unique([layoutId, previewVersionId])
  @@index([userId, createdAt])
}

model TariffVersion {
  id                String       @id @default(uuid()) @db.Uuid
  version           Int          @unique
  status            TariffStatus @default(ACTIVE)
  currency          String       @default("UZS") @db.Char(3)
  basePriceMinor    BigInt
  perPagePriceMinor BigInt
  createdById       String       @db.Uuid
  createdAt         DateTime     @default(now())
  retiredAt         DateTime?
  createdBy         User         @relation("TariffAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  priceSnapshots    PriceSnapshot[]

  @@index([status, version])
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  layoutId            String      @db.Uuid
  layoutApprovalId    String      @unique @db.Uuid
  printReadyVersionId String      @db.Uuid
  status              OrderStatus @default(AWAITING_PAYMENT)
  version             Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  layout              LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  layoutApproval      LayoutApproval @relation(fields: [layoutApprovalId], references: [id], onDelete: Restrict)
  printReadyVersion   PrintReadyVersion @relation(fields: [printReadyVersionId], references: [id], onDelete: Restrict)
  priceSnapshot       PriceSnapshot?
  payment             Payment?
  matching            OrderMatching?
  partnerOffers       PartnerOffer[]
  assignments         PartnerAssignment[]
  fulfillment         OrderFulfillment?
  printJob            PrintJob?
  deliveryTask        DeliveryTask?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

/// Courier onboarding is role-gated independently from partner ownership.
model CourierProfile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @db.Uuid
  displayName String        @db.VarChar(160)
  serviceZone String        @db.VarChar(40)
  status      CourierStatus @default(PENDING)
  active      Boolean       @default(true)
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries DeliveryTask[]

  @@index([status, active, serviceZone])
}

/// One fulfillment aggregate per order. PIN material is derived from a secret and opaque nonce.
model OrderFulfillment {
  id                    String            @id @default(uuid()) @db.Uuid
  orderId               String            @unique @db.Uuid
  mode                  FulfillmentMode
  status                FulfillmentStatus @default(AWAITING_HANDOFF)
  requestKeyDigest      String            @db.Char(64)
  requestHash           String            @db.Char(64)
  completionNonce       String            @db.Char(32)
  completionPinDigest   String            @db.Char(64)
  completionAttempts    Int               @default(0)
  completionExpiresAt   DateTime
  completionUsedAt      DateTime?
  handoffNonce          String?           @db.Char(32)
  handoffPinDigest      String?           @db.Char(64)
  handoffAttempts       Int               @default(0)
  handoffUsedAt         DateTime?
  addressCiphertext     String?           @db.Text
  addressIv             String?           @db.VarChar(24)
  addressAuthTag        String?           @db.VarChar(32)
  version               Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  delivery              DeliveryTask?

  @@unique([orderId, requestKeyDigest])
  @@index([status, completionExpiresAt])
}

model DeliveryTask {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @unique @db.Uuid
  fulfillmentId     String         @unique @db.Uuid
  courierId         String         @db.Uuid
  branchId          String         @db.Uuid
  providerReference String         @unique @db.VarChar(160)
  status            DeliveryStatus @default(ASSIGNED)
  active            Boolean        @default(true)
  version           Int            @default(0)
  assignedAt        DateTime       @default(now())
  pickedUpAt        DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureCode       String?        @db.VarChar(40)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fulfillment       OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  courier           CourierProfile @relation(fields: [courierId], references: [id], onDelete: Restrict)
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([courierId, active, assignedAt])
  @@index([status, assignedAt])
}

/// Machine identity for the branch-local printer agent. Only a token digest is stored.
model PrinterAgent {
  id          String             @id @default(uuid()) @db.Uuid
  branchId    String             @db.Uuid
  label       String             @db.VarChar(80)
  tokenDigest String             @unique @db.Char(64)
  status      PrinterAgentStatus @default(ACTIVE)
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("PrinterAgentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  jobs        PrintJob[]

  @@index([branchId, status])
}

model PrintJob {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @unique @db.Uuid
  assignmentId    String         @unique @db.Uuid
  branchId        String         @db.Uuid
  agentId         String?        @db.Uuid
  status          PrintJobStatus @default(PENDING)
  version         Int            @default(0)
  attempts        Int            @default(0)
  leaseUntil      DateTime?
  failureCode     String?        @db.VarChar(40)
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignment      PartnerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agent           PrinterAgent?  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([branchId, status, createdAt])
  @@index([agentId, status])
}

model OrderMatching {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @unique @db.Uuid
  status      MatchingStatus @default(ACTIVE)
  version     Int            @default(0)
  startedAt   DateTime       @default(now())
  exhaustedAt DateTime?
  assignedAt  DateTime?
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
}

model PartnerOffer {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @db.Uuid
  partnerId           String             @db.Uuid
  branchId            String             @db.Uuid
  capabilityVersionId String             @db.Uuid
  candidateRank       Int
  status              PartnerOfferStatus @default(PENDING)
  version             Int                @default(0)
  expiresAt           DateTime
  decidedAt           DateTime?
  createdAt           DateTime           @default(now())
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner             Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  capabilityVersion   BranchCapabilityVersion @relation(fields: [capabilityVersionId], references: [id], onDelete: Restrict)
  payoutSnapshot      PartnerPayoutSnapshot?
  assignment          PartnerAssignment?

  @@unique([orderId, branchId])
  @@index([partnerId, status, expiresAt])
  @@index([status, expiresAt])
}

/// Financial terms are append-only and never updated after offer creation.
model PartnerPayoutSnapshot {
  id                   String   @id @default(uuid()) @db.Uuid
  offerId              String   @unique @db.Uuid
  customerAmountMinor  BigInt
  partnerPayoutMinor   BigInt
  agatCommissionMinor  BigInt
  currency             String   @default("UZS") @db.Char(3)
  ruleVersion          String   @db.VarChar(40)
  calculationInputs    Json
  createdAt            DateTime @default(now())
  offer                PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  assignment           PartnerAssignment?
}

model PartnerAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  orderId          String           @db.Uuid
  offerId          String           @unique @db.Uuid
  partnerId        String           @db.Uuid
  branchId         String           @db.Uuid
  payoutSnapshotId String           @unique @db.Uuid
  status           AssignmentStatus @default(ACTIVE)
  active           Boolean          @default(true)
  version          Int              @default(0)
  acceptedAt       DateTime         @default(now())
  readyAt          DateTime?
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offer            PartnerOffer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  partner          Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payoutSnapshot   PartnerPayoutSnapshot @relation(fields: [payoutSnapshotId], references: [id], onDelete: Restrict)
  printJob         PrintJob?

  @@index([orderId, active])
  @@index([partnerId, active])
}

model PriceSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @unique @db.Uuid
  tariffVersionId   String   @db.Uuid
  tariffVersion     Int
  sourceParameters  Json
  lineItems         Json
  quantity          Int
  subtotalMinor     BigInt
  discountMinor     BigInt   @default(0)
  totalMinor        BigInt
  currency          String   @db.Char(3)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tariff            TariffVersion @relation(fields: [tariffVersionId], references: [id], onDelete: Restrict)
}

model Payment {
  id                       String        @id @default(uuid()) @db.Uuid
  orderId                  String        @unique @db.Uuid
  provider                 String        @db.VarChar(30)
  providerPaymentReference String?       @unique @db.VarChar(160)
  amountMinor              BigInt
  currency                 String        @db.Char(3)
  status                   PaymentStatus @default(PENDING)
  version                  Int           @default(0)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds                  RefundOperation[]

  @@index([status, updatedAt])
}

model RefundOperation {
  id                      String       @id @default(uuid()) @db.Uuid
  paymentId               String       @unique @db.Uuid
  triggerDedupKey         String       @unique @db.Char(64)
  providerRefundReference String?      @unique @db.VarChar(160)
  amountMinor             BigInt
  status                  RefundStatus @default(REQUESTED)
  createdAt               DateTime     @default(now())
  confirmedAt             DateTime?
  payment                 Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String   @db.VarChar(80)
  keyDigest   String   @db.Char(64)
  requestHash String   @db.Char(64)
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, keyDigest])
  @@index([expiresAt])
}

model ProviderCallback {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(30)
  eventId     String   @db.Uuid
  payloadHash String   @db.Char(64)
  result      Json
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

model ManualReview {
  id               String             @id @default(uuid()) @db.Uuid
  layoutId         String             @db.Uuid
  previewVersionId String             @unique @db.Uuid
  status           ManualReviewStatus @default(PENDING)
  reason           String             @db.VarChar(80)
  reviewerId       String?            @db.Uuid
  decisionAt       DateTime?
  version          Int                @default(0)
  createdAt        DateTime           @default(now())
  layout           LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  reviewer         User? @relation("ManualReviewOperator", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model OutboxEvent {
  id               String   @id @default(uuid()) @db.Uuid
  aggregateType    String   @db.VarChar(50)
  aggregateId      String   @db.Uuid
  aggregateVersion Int
  eventType        String   @db.VarChar(80)
  dedupKey         String   @unique @db.Char(64)
  payload          Json
  createdAt        DateTime @default(now())
  publishedAt      DateTime?

  @@index([publishedAt, createdAt])
}

model InboxOperation {
  dedupKey    String   @id @db.Char(64)
  operation   String   @db.VarChar(80)
  completedAt DateTime @default(now())
  resultId    String?  @db.Uuid
}
