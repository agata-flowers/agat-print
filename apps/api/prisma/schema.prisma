generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PARTNER
  COURIER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ObjectRetentionClass {
  ORIGINAL
  PREVIEW
  DERIVATIVE
  PRINT_READY
}

enum UploadFileKind {
  PDF
  DOCX
  JPEG
  PNG
}

enum UploadStatus {
  CREATED
  QUARANTINED
  SCANNING
  QUEUED
  PROCESSING
  READY
  REJECTED
  CANCELLED
  EXPIRED
  FAILED
}

enum ProcessingOperation {
  NORMALIZE
  PREFLIGHT
}

enum LayoutStatus {
  PROCESSING
  QUALITY_CHECK_FAILED
  MANUAL_REVIEW_REQUIRED
  AWAITING_APPROVAL
  APPROVED
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  phone       String         @unique @db.VarChar(32)
  locale      String         @default("ru") @db.VarChar(8)
  displayName String?        @db.VarChar(160)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roles       UserRole[]
  sessions    Session[]
  challenges OtpChallenge[]
  partner     Partner?
  auditEvents AuditEvent[]   @relation("AuditActor")
  uploads     UploadSession[]
  layouts     LayoutRequest[]
  layoutApprovals LayoutApproval[]
  manualReviews ManualReview[] @relation("ManualReviewOperator")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model OtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String    @db.VarChar(32)
  codeDigest  String    @db.Char(64)
  attempts    Int       @default(0)
  maxAttempts Int
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshDigest    String    @db.Char(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid
  reuseDetectedAt  DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model Partner {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @unique @db.Uuid
  displayName String        @db.VarChar(180)
  status      PartnerStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  branches    Branch[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  name      String   @db.VarChar(180)
  city      String   @default("Tashkent") @db.VarChar(100)
  district  String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  eventType  String   @db.VarChar(80)
  targetType String?  @db.VarChar(50)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
}

model BootstrapState {
  key       String   @id @db.VarChar(50)
  usedAt    DateTime
  createdAt DateTime @default(now())
}

/// Infrastructure record used by backup/retention. It does not expose uploads.
model PermanentObjectReference {
  objectKey      String               @id @db.VarChar(1024)
  checksum       String               @db.Char(64)
  retentionClass ObjectRetentionClass
  expiresAt      DateTime
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())

  @@index([expiresAt, deletedAt])
}

/// Deletion marker replayed before restored object storage is exposed.
model RetentionTombstone {
  objectKey String   @id @db.VarChar(1024)
  deletedAt DateTime @default(now())
  reason    String?  @db.VarChar(80)

  @@index([deletedAt])
}

/// A quota reservation and lifecycle record. Original filenames are never stored.
model UploadSession {
  id                  String         @id @default(uuid()) @db.Uuid
  fileVersion         String         @unique @default(uuid()) @db.Uuid
  userId              String         @db.Uuid
  fileKind            UploadFileKind
  declaredMime        String         @db.VarChar(100)
  expectedSizeBytes   BigInt
  actualSizeBytes     BigInt?
  sha256              String?        @db.Char(64)
  pageCount           Int?
  pixelCount          BigInt?
  status              UploadStatus   @default(CREATED)
  quarantineObjectKey String         @unique @db.VarChar(160)
  permanentObjectKey  String?        @unique @db.VarChar(160)
  version             Int            @default(0)
  expiresAt           DateTime
  cancelledAt         DateTime?
  completedAt         DateTime?
  rejectionCode       String?        @db.VarChar(80)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  processingJobs      ProcessingJob[]
  processingResults   ProcessingResult[]
  layout               LayoutRequest?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model ProcessingJob {
  id           String              @id @default(uuid()) @db.Uuid
  uploadId     String              @db.Uuid
  operation    ProcessingOperation
  settingsHash String              @db.Char(64)
  dedupKey     String              @unique @db.Char(64)
  resultObjectKey String           @unique @db.VarChar(160)
  status       ProcessingJobStatus @default(PENDING)
  aggregateVersion Int
  attempts     Int                 @default(0)
  leaseOwner   String?             @db.VarChar(100)
  leaseUntil   DateTime?
  lastErrorCode String?            @db.VarChar(80)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  upload       UploadSession       @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  result       ProcessingResult?

  @@index([status, leaseUntil])
}

model ProcessingResult {
  id         String          @id @default(uuid()) @db.Uuid
  jobId      String          @unique @db.Uuid
  uploadId   String          @db.Uuid
  objectKey  String          @unique @db.VarChar(160)
  checksum   String          @db.Char(64)
  sizeBytes  BigInt
  pageCount  Int
  createdAt  DateTime        @default(now())
  job        ProcessingJob   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  upload     UploadSession   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  previewVersions PreviewVersion[]
  printReadyVersions PrintReadyVersion[]
}

/// Mutable pointer to the current layout revision; immutable artifacts live below.
model LayoutRequest {
  id                   String       @id @default(uuid()) @db.Uuid
  uploadId             String       @unique @db.Uuid
  userId               String       @db.Uuid
  sourceFileVersion    String       @db.Uuid
  settingsHash         String       @db.Char(64)
  settings             Json
  status               LayoutStatus @default(PROCESSING)
  version              Int          @default(0)
  latestPreviewId      String?      @db.Uuid
  latestPrintReadyId   String?      @db.Uuid
  currentApprovalId    String?      @db.Uuid
  qualityCode          String?      @db.VarChar(80)
  manualReviewReason   String?      @db.VarChar(80)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  upload               UploadSession @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  previews             PreviewVersion[]
  printReadyVersions   PrintReadyVersion[]
  approvals            LayoutApproval[]
  manualReviews        ManualReview[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

model PreviewVersion {
  id                       String   @id @default(uuid()) @db.Uuid
  layoutId                 String   @db.Uuid
  version                  Int
  objectKey                String   @unique @db.VarChar(160)
  checksum                 String   @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String   @db.Uuid
  settingsHash             String   @db.Char(64)
  originProcessingResultId String   @db.Uuid
  pageCount                Int
  createdAt                DateTime @default(now())
  layout                   LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)
  approvals                LayoutApproval[]
  manualReview             ManualReview?

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model PrintReadyVersion {
  id                       String   @id @default(uuid()) @db.Uuid
  layoutId                 String   @db.Uuid
  version                  Int
  objectKey                String   @unique @db.VarChar(160)
  checksum                 String   @db.Char(64)
  sizeBytes                BigInt
  sourceFileVersion        String   @db.Uuid
  settingsHash             String   @db.Char(64)
  originProcessingResultId String   @db.Uuid
  pageCount                Int
  createdAt                DateTime @default(now())
  layout                   LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  originProcessingResult   ProcessingResult @relation(fields: [originProcessingResultId], references: [id], onDelete: Restrict)

  @@unique([layoutId, version])
  @@unique([layoutId, sourceFileVersion, settingsHash])
}

model LayoutApproval {
  id               String   @id @default(uuid()) @db.Uuid
  layoutId         String   @db.Uuid
  previewVersionId String   @db.Uuid
  userId           String   @db.Uuid
  layoutVersion    Int
  createdAt        DateTime @default(now())
  layout           LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  user             User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([layoutId, previewVersionId])
  @@index([userId, createdAt])
}

model ManualReview {
  id               String             @id @default(uuid()) @db.Uuid
  layoutId         String             @db.Uuid
  previewVersionId String             @unique @db.Uuid
  status           ManualReviewStatus @default(PENDING)
  reason           String             @db.VarChar(80)
  reviewerId       String?            @db.Uuid
  decisionAt       DateTime?
  version          Int                @default(0)
  createdAt        DateTime           @default(now())
  layout           LayoutRequest @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  previewVersion   PreviewVersion @relation(fields: [previewVersionId], references: [id], onDelete: Restrict)
  reviewer         User? @relation("ManualReviewOperator", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model OutboxEvent {
  id               String   @id @default(uuid()) @db.Uuid
  aggregateType    String   @db.VarChar(50)
  aggregateId      String   @db.Uuid
  aggregateVersion Int
  eventType        String   @db.VarChar(80)
  dedupKey         String   @unique @db.Char(64)
  payload          Json
  createdAt        DateTime @default(now())
  publishedAt      DateTime?

  @@index([publishedAt, createdAt])
}

model InboxOperation {
  dedupKey    String   @id @db.Char(64)
  operation   String   @db.VarChar(80)
  completedAt DateTime @default(now())
  resultId    String?  @db.Uuid
}
