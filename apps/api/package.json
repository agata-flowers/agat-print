{
  "name": "@agat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "node scripts/prisma-validate.mjs",
    "db:migrate": "prisma migrate dev",
    "admin:bootstrap": "tsx src/cli/admin-bootstrap.ts"
  },
  "dependencies": {
    "@agat/contracts": "workspace:*",
    "@agat/providers": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.14.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "prisma": "6.14.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "vitest": "3.2.4"
  }
}
