# Copy to .env for local development only. Never commit real credentials.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
DATABASE_URL=postgresql://agat:development-only@localhost:5432/agat_print?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=development-only
MINIO_SECRET_KEY=development-only-change-me
MINIO_BUCKET=agat-private
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Stage 3 MVP limits. Values are bytes/counts and may be reduced per deployment.
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_PAGES=100
UPLOAD_USER_ACTIVE_QUOTA_BYTES=262144000
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_SESSION_TTL_SECONDS=86400
DOCX_MAX_ENTRIES=2000
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_COMPRESSION_RATIO=100
PROCESSING_DISPATCH_ENABLED=false
PROCESSING_IMAGE=agat-processing:local
PROCESSING_RUNNER_SCRIPT=ops/processing/run-job.sh
PROCESSING_SECCOMP_PROFILE=ops/processing/seccomp.json
PROCESSING_TIMEOUT_SECONDS=120
PREVIEW_SIGNED_URL_TTL_SECONDS=300
MINIO_BUCKET=agat-private
MINIO_ACCESS_KEY=development-only
MINIO_SECRET_KEY=development-only-change-me
JWT_ACCESS_SECRET=development-only-change-me-at-least-32-chars
OTP_PROVIDER=mock
MOCK_OTP_CODE=000000
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=development-only-mock-payment-secret
MATCHING_DISPATCH_ENABLED=false
PARTNER_OFFER_TTL_SECONDS=180
PARTNER_PAYOUT_BASIS_POINTS=8000
PARTNER_PAYOUT_RULE_VERSION=mvp-v1
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Backup: production values must point off-host. Keep RESTIC_PASSWORD outside this file.
RESTIC_REPOSITORY=s3:https://backup.example.invalid/agat-print
BACKUP_S3_URL=https://backup.example.invalid
AWS_ACCESS_KEY_ID=replace-outside-repository
AWS_SECRET_ACCESS_KEY=replace-outside-repository
RESTIC_PASSWORD=replace-outside-repository
BACKUP_RETENTION_DAYS=30
